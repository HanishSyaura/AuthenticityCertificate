generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users           User[]
  products        Product[]
  categories      Category[]
  batches         Batch[]
  corpSequences   CorpSequence[]
  epcBatches      EpcBatch[]
  epcItems        EpcItem[]
  certificates    Certificate[]
  scanLogs        ScanLog[]
  fraudFlags      FraudFlag[]
  tagIdentities   TagIdentity[]
  apiKeys         ApiKey[]
  webhooks        WebhookEndpoint[]
  pages           CmsPage[]
  layouts         CmsLayout[]
  cmsVersions     CmsVersion[]
  cmsTranslations CmsTranslation[]
  templates       CertificateTemplate[]
  mediaAssets     MediaAsset[]
  auditLogs       AuditLog[]
}

model ApiKey {
  id              Int          @id @default(autoincrement())
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  key             String       @unique
  rateLimitPerMin Int          @default(120)
  createdAt       DateTime     @default(now())
  revokedAt       DateTime?
  deletedAt       DateTime?

  @@index([organizationId])
}

model WebhookEndpoint {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  url            String
  secret         String
  eventsJson     Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, isActive])
}

enum UserRoleEnum {
  super_admin
  admin
  operator
}

model User {
  id             Int           @id @default(autoincrement())
  name           String
  email          String        @unique
  password       String
  role           UserRoleEnum  @default(admin)
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  roles UserRole[]

  auditLogs          AuditLog[]
  resolvedFraudFlags FraudFlag[]
}

model AuditLog {
  id             Int           @id @default(autoincrement())
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorEmail     String?
  action         String
  targetType     String?
  targetId       String?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Product {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  code           String
  category       String
  status         String
  remark         String?
  origin         String?
  description    String?
  cmsPageId      Int? // Linked CMS landing page
  cmsPage        CmsPage?     @relation("LandingPage", fields: [cmsPageId], references: [id])
  cmsCertificatePageId Int? // Linked CMS certificate page
  cmsCertificatePage   CmsPage? @relation("CertificatePage", fields: [cmsCertificatePageId], references: [id])
  certificateTemplateId Int?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  batches        Batch[]

  epcBatches EpcBatch[]

  versionNo Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, code])
  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@index([organizationId, status])
}

model Category {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model Batch {
  id             Int           @id @default(autoincrement())
  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id])
  batchNo        String
  productId      Int
  product        Product       @relation(fields: [productId], references: [id])
  certificates   Certificate[]

  versionNo Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, batchNo])
}

model CorpSequence {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  corpPrefix     String
  lastNo         BigInt       @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, corpPrefix])
  @@index([organizationId])
}

model EpcBatch {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  corpPrefix     String

  productId Int
  product   Product @relation(fields: [productId], references: [id])
  sku       String

  batchName String
  batchQty  Int
  remark    String?
  certificateId String?
  certificate   Certificate? @relation(fields: [certificateId], references: [certificateId])
  certificateTemplateId Int?
  certificateTemplate   CertificateTemplate? @relation("EpcBatchTemplate", fields: [certificateTemplateId], references: [id])
  templateData Json?
  productionUploadedAt DateTime?
  productionDoneAt     DateTime?

  createdAt DateTime @default(now())

  items EpcItem[]

  @@index([organizationId, createdAt])
  @@index([organizationId, corpPrefix])
  @@index([organizationId, productId])
  @@index([organizationId, certificateId])
}

model EpcItem {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  batchId Int
  batch   EpcBatch @relation(fields: [batchId], references: [id])

  epcCode   String
  runningNo BigInt
  netWeight String?
  productionDate DateTime?
  caiqNumber String?
  createdAt DateTime @default(now())

  @@unique([organizationId, epcCode])
  @@index([organizationId, createdAt])
  @@index([batchId])
}

model Certificate {
  certificateId  String       @id // Format: BN-XXXXXXXXXX
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String // batch | unit
  status         String       @default("PENDING") // PENDING, VALID, SUSPICIOUS, REVOKED, EXPIRED
  batchId        Int
  batch          Batch        @relation(fields: [batchId], references: [id])
  scanLogs       ScanLog[]
  fraudFlags     FraudFlag[]
  createdAt      DateTime     @default(now())

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  issuedAt       DateTime? // set when activated/bound
  expiresAt      DateTime?
  revokedAt      DateTime?
  reissuedFromId String?
  reissuedToId   String?

  identities TagIdentity[]

  @@index([certificateId])
}

model ScanLog {
  id             Int           @id @default(autoincrement())
  certificateId  String
  certificate    Certificate   @relation(fields: [certificateId], references: [certificateId])
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  nfcUid         String?
  epc            String?
  ip             String
  userAgent      String
  deviceHash     String?
  country        String?
  latitude       Float?
  longitude      Float?
  timestamp      DateTime      @default(now())

  @@index([organizationId, timestamp])
  @@index([certificateId, timestamp])
}

enum FraudSeverity {
  low
  medium
  high
}

enum FraudStatus {
  open
  resolved
}

model FraudFlag {
  id               Int           @id @default(autoincrement())
  organizationId   Int
  organization     Organization  @relation(fields: [organizationId], references: [id])
  certificateId    String
  certificate      Certificate   @relation(fields: [certificateId], references: [certificateId])
  reason           String
  severity         FraudSeverity @default(medium)
  status           FraudStatus   @default(open)
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?
  resolvedByUserId Int?
  resolvedByUser   User?         @relation(fields: [resolvedByUserId], references: [id])

  @@index([organizationId, status])
  @@index([certificateId, status])
  @@index([createdAt])
}

model TagIdentity {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  certificateId  String
  certificate    Certificate  @relation(fields: [certificateId], references: [certificateId])
  nfcUid         String?
  epc            String?
  assignedAt     DateTime     @default(now())
  lastSeenAt     DateTime?
  unassignedAt   DateTime?

  @@unique([organizationId, nfcUid])
  @@unique([organizationId, epc])
  @@index([certificateId])
}

model CmsPage {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  slug           String
  kind           String       @default("landing")
  sortOrder      Int          @default(0)
  layout         CmsLayout?
  landingProducts     Product[] @relation("LandingPage")
  certificateProducts Product[] @relation("CertificatePage")

  metaTitle       String?
  metaDescription String?
  ogImage         String?

  draftVersionId     Int?
  draftVersion       CmsVersion? @relation("DraftVersion", fields: [draftVersionId], references: [id])
  publishedVersionId Int?
  publishedVersion   CmsVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  versions     CmsVersion[]
  translations CmsTranslation[]

  versionNo Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, slug])
  @@index([organizationId, kind])
}

model CmsVersion {
  id                Int          @id @default(autoincrement())
  organizationId    Int
  organization      Organization @relation(fields: [organizationId], references: [id])
  pageId            Int
  page              CmsPage      @relation(fields: [pageId], references: [id])
  draftForPages     CmsPage[]    @relation("DraftVersion")
  publishedForPages CmsPage[]    @relation("PublishedVersion")
  versionNo         Int
  status            String       @default("draft")
  layoutJson        Json
  createdAt         DateTime     @default(now())

  @@unique([pageId, versionNo])
  @@index([organizationId, pageId])
}

model CmsTranslation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  pageId         Int
  page           CmsPage      @relation(fields: [pageId], references: [id])
  language       String
  contentJson    Json
  updatedAt      DateTime     @updatedAt

  @@unique([pageId, language])
  @@index([organizationId, pageId])
}

model CmsLayout {
  id             Int          @id @default(autoincrement())
  pageId         Int          @unique
  page           CmsPage      @relation(fields: [pageId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  layoutJson     Json // FULL drag-drop structure

  updatedAt DateTime @updatedAt
}

model CertificateTemplate {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  background     String // URL to background image
  backgroundColor String      @default("#ffffff")
  layoutJson     Json // Overlay field positions
  placeholders   Json?
  canvasWidth    Int          @default(390)
  canvasHeight   Int          @default(844)

  products Product[]
  epcBatches EpcBatch[] @relation("EpcBatchTemplate")

  versionNo Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model MediaAsset {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  originalName String
  fileName     String
  mimeType     String
  sizeBytes    Int
  url          String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([createdAt])
  @@unique([organizationId, fileName])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
}
