generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

// Global org-wide branding / settings (maps to legacy OrganizationSettings table)
model OrganizationSetting {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @unique
  organization     Organization @relation(fields: [organizationId], references: [id])

  defaultLocale    String?  @db.VarChar(20)
  defaultTimezone  String?  @db.VarChar(64)
  maintenanceMode  Boolean  @default(false)

  // Branding
  appTitle         String?  @db.VarChar(191)
  faviconUrl       String?  @db.VarChar(512)
  logoUrl          String?  @db.VarChar(512)

  // SMTP
  smtpHost         String?  @db.VarChar(191)
  smtpPort         Int?
  smtpSecure       Boolean?
  smtpUser         String?  @db.VarChar(191)
  smtpPassEnc      String?  @db.Text
  smtpFromName     String?  @db.VarChar(191)
  smtpFromEmail    String?  @db.VarChar(191)
  smtpReplyTo      String?  @db.VarChar(191)
  adminAppUrl      String?  @db.VarChar(512)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("OrganizationSettings")
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users           User[]
  products        Product[]
  categories      Category[]
  batches         Batch[]
  corpSequences   CorpSequence[]
  corpMonthSequences CorpMonthSequence[]
  epcBatches      EpcBatch[]
  epcItems        EpcItem[]
  epcBatchDocuments EpcBatchDocument[]
  epcItemDocuments  EpcItemDocument[]
  epcScanGroups     EpcScanGroup[]
  epcScanGroupItems EpcScanGroupItem[]
  productSupportingCertificates ProductSupportingCertificate[]
  certificates    Certificate[]
  scanLogs        ScanLog[]
  fraudFlags      FraudFlag[]
  tagIdentities   TagIdentity[]
  apiKeys         ApiKey[]
  webhooks        WebhookEndpoint[]
  settings        OrganizationSetting?

  // CMS
  cmsDesigns      CmsDesign[]
  pages           CmsPage[]
  layouts         CmsLayout[]
  cmsVersions     CmsVersion[]
  cmsTranslations CmsTranslation[]
  templates       CertificateTemplate[]
  templateTranslations CertificateTemplateTranslation[]
  mediaAssets     MediaAsset[]
  auditLogs       AuditLog[]
  notificationConfigs OrganizationNotificationConfig[]
}

model ApiKey {
  id              Int          @id @default(autoincrement())
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  key             String       @unique
  rateLimitPerMin Int          @default(120)
  createdAt       DateTime     @default(now())
  revokedAt       DateTime?
  deletedAt       DateTime?

  @@index([organizationId])
}

model WebhookEndpoint {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  url            String
  secret         String
  eventsJson     Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, isActive])
}

enum UserRoleEnum {
  super_admin
  admin
  operator
}

model User {
  id             Int           @id @default(autoincrement())
  name           String
  email          String        @unique
  password       String
  role           UserRoleEnum  @default(admin)
  mustResetPassword Boolean    @default(false)
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  roles UserRole[]

  auditLogs          AuditLog[]
  resolvedFraudFlags FraudFlag[]
}

model AuditLog {
  id             Int           @id @default(autoincrement())
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorEmail     String?
  action         String
  targetType     String?
  targetId       String?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([action], map: "AuditLog_action_idx")
  @@index([targetType, targetId], map: "AuditLog_targetType_targetId_idx")
  @@index([createdAt], map: "AuditLog_createdAt_idx")
}

model Product {
  id                      Int                  @id @default(autoincrement())
  organizationId          Int
  organization            Organization         @relation(fields: [organizationId], references: [id])
  sku                     String
  name                    String
  code                    String
  category                String
  status                  String
  remark                  String?
  origin                  String?
  description             String?

  // ===== LEGACY / DEPRECATED COLUMNS (single-page FKs — keep for old data / backward compat only) =====
  cmsPageId               Int?
  cmsPage                 CmsPage?             @relation("LandingPage", fields: [cmsPageId], references: [id])
  cmsCertificatePageId    Int?
  cmsCertificatePage      CmsPage?             @relation("CertificatePage", fields: [cmsCertificatePageId], references: [id])

  // ===== NEW: GROUP-LEVEL FK (links to CmsDesign.id = BUNDLE of multiple inner pages) =====
  // Landing page bundle for public product page
  cmsDesignId             Int?
  cmsDesign               CmsDesign?          @relation("LandingDesign", fields: [cmsDesignId], references: [id])
  // Optional: separate bundle for certificate-only view (if different from product landing)
  cmsCertificateDesignId  Int?
  cmsCertificateDesign    CmsDesign?          @relation("CertificateDesign", fields: [cmsCertificateDesignId], references: [id])

  certificateTemplateId   Int?
  certificateTemplate     CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  batches                 Batch[]

  epcBatches              EpcBatch[]
  epcScanGroups           EpcScanGroup[]
  supportingCertificates  ProductSupportingCertificate[]

  versionNo   Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([organizationId, code], map: "Product_organizationId_code_key")
  @@unique([organizationId, sku], map: "Product_organizationId_sku_key")
  @@index([organizationId, category], map: "Product_organizationId_category_idx")
  @@index([organizationId, status], map: "Product_organizationId_status_idx")
  @@index([organizationId, cmsDesignId], map: "Product_organizationId_cmsDesignId_idx")
  @@index([organizationId, cmsCertificateDesignId], map: "Product_organizationId_cmsCertDesignId_idx")
}

model ProductSupportingCertificate {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])

  sortOrder Int    @default(0)
  title     String?

  certificateTemplateId Int?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  templateData          Json?
  mediaUrl              String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, productId, sortOrder], map: "PSC_org_productId_sortOrder_idx")
  @@index([organizationId, productId], map: "PSC_org_productId_idx")
}

model Category {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, code], map: "Category_organizationId_code_key")
  @@index([organizationId, isActive], map: "Category_org_isActive_idx")
}

model Batch {
  id             Int           @id @default(autoincrement())
  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id])
  batchNo        String
  productId      Int
  product        Product       @relation(fields: [productId], references: [id])
  certificates   Certificate[]

  versionNo Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, batchNo], map: "Batch_organizationId_batchNo_key")
}

model CorpSequence {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  corpPrefix     String
  skuCode        String
  lastNo         BigInt       @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, corpPrefix, skuCode], map: "CorpSequence_org_corpPrefix_skuCode_key")
  @@index([organizationId], map: "CorpSequence_organizationId_idx")
}

model CorpMonthSequence {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  corpPrefix     String
  periodKey      String // YYYYMM (ikut timezone org)
  lastNo         BigInt       @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, corpPrefix, periodKey], map: "CorpMonthSeq_org_corpPrefix_periodKey_key")
  @@index([organizationId], map: "CorpMonthSequence_org_idx")
}

model CertificateSequence {
  dateKey   String   @id
  lastNo    BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model EpcBatchSequence {
  dateKey   String   @id // YYYYMMDD (ikut timezone org)
  lastNo    BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model ImportBatchSequence {
  dateKey   String   @id // YYYYMMDD (ikut timezone org)
  lastNo    BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model EpcBatch {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  corpPrefix     String
  periodKey      String?

  origin String @default("generated") // generated | import

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  sku       String?

  batchName             String
  batchQty              Int
  remark                String?
  certificateId         String?
  certificate           Certificate?         @relation("EpcBatchCertificate", fields: [certificateId], references: [certificateId])
  certificateTemplateId Int?
  certificateTemplate   CertificateTemplate? @relation("EpcBatchTemplate", fields: [certificateTemplateId], references: [id])
  templateData          Json?
  productionUploadedAt  DateTime?
  productionDoneAt      DateTime?

  createdAt DateTime @default(now())

  items EpcItem[]
  documents EpcBatchDocument[]

  @@index([organizationId, createdAt])
  @@index([organizationId, corpPrefix])
  @@index([organizationId, origin])
  @@index([organizationId, productId])
  @@index([organizationId, certificateId])
}

model EpcItem {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  batchId Int
  batch   EpcBatch @relation(fields: [batchId], references: [id])

  epcCode        String
  runningNo      BigInt
  barcode        String?
  batchNumber    String?
  swiftletHouseNumber String?
  netWeight      String?
  productionDate DateTime?
  caiqNumber     String?
  createdAt      DateTime  @default(now())

  documents EpcItemDocument[]
  scanGroupItems EpcScanGroupItem[]

  @@unique([organizationId, epcCode])
  @@index([organizationId, createdAt])
  @@index([batchId])
}

model EpcBatchDocument {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  batchId Int
  batch   EpcBatch @relation(fields: [batchId], references: [id])

  docType  String
  mediaUrl String

  uploadedAt DateTime @default(now())

  @@unique([batchId, docType])
  @@index([organizationId, uploadedAt])
  @@index([batchId])
}

model EpcItemDocument {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  epcItemId Int
  epcItem   EpcItem @relation(fields: [epcItemId], references: [id])

  docType  String
  mediaUrl String

  uploadedAt DateTime @default(now())

  @@unique([epcItemId, docType])
  @@index([organizationId, uploadedAt])
  @@index([epcItemId])
}

model EpcScanGroup {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  status String @default("OPEN") // OPEN | ASSIGNED | CANCELLED

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  createdByEmail  String?
  assignedByEmail String?
  assignedAt      DateTime?

  createdAt DateTime @default(now())

  items EpcScanGroupItem[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, productId])
}

model EpcScanGroupItem {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  scanGroupId Int
  scanGroup   EpcScanGroup @relation(fields: [scanGroupId], references: [id])

  epcItemId Int
  epcItem   EpcItem @relation(fields: [epcItemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([scanGroupId, epcItemId])
  @@index([organizationId, scanGroupId])
  @@index([organizationId, epcItemId])
}

model Certificate {
  certificateId  String       @id // Format: BN-XXXXXXXXXX
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String // batch | unit
  status         String       @default("PENDING") // PENDING, VALID, SUSPICIOUS, REVOKED, EXPIRED
  batchId        Int?
  batch          Batch?       @relation(fields: [batchId], references: [id])

  // ===== DEPRECATED OLD FK (per-cert single-page override — keep for migration only) =====
  cmsPageId      Int?
  cmsPage        CmsPage?     @relation("CertificateLandingPage", fields: [cmsPageId], references: [id])

  // ===== NEW: GROUP-LEVEL PER-CERT OVERRIDE (points to CmsDesign.id = BUNDLE of multiple inner pages) =====
  // HIGHEST PRIORITY: cert-specific landing design (overrides product design bundle)
  cmsDesignId    Int?
  cmsDesign      CmsDesign?  @relation("CertificateDesign2", fields: [cmsDesignId], references: [id])

  epcBatches     EpcBatch[]   @relation("EpcBatchCertificate")
  scanLogs       ScanLog[]
  fraudFlags     FraudFlag[]
  createdAt      DateTime     @default(now())

  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  issuedAt       DateTime? // set when activated/bound
  expiresAt      DateTime?
  revokedAt      DateTime?
  reissuedFromId String?
  reissuedToId   String?

  identities     TagIdentity[]

  @@index([certificateId], map: "Certificate_certificateId_idx")
  @@index([organizationId, cmsDesignId], map: "Certificate_org_cmsDesignId_idx")
}

model ScanLog {
  id             Int           @id @default(autoincrement())
  certificateId  String
  certificate    Certificate   @relation(fields: [certificateId], references: [certificateId])
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  nfcUid         String?
  epc            String?
  ip             String
  userAgent      String
  deviceHash     String?
  country        String?
  latitude       Float?
  longitude      Float?
  timestamp      DateTime      @default(now())

  @@index([organizationId, timestamp])
  @@index([certificateId, timestamp])
}

enum FraudSeverity {
  low
  medium
  high
}

enum FraudStatus {
  open
  resolved
}

model FraudFlag {
  id               Int           @id @default(autoincrement())
  organizationId   Int
  organization     Organization  @relation(fields: [organizationId], references: [id])
  certificateId    String
  certificate      Certificate   @relation(fields: [certificateId], references: [certificateId])
  reason           String
  severity         FraudSeverity @default(medium)
  status           FraudStatus   @default(open)
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?
  resolvedByUserId Int?
  resolvedByUser   User?         @relation(fields: [resolvedByUserId], references: [id])

  @@index([organizationId, status])
  @@index([certificateId, status])
  @@index([createdAt])
}

model TagIdentity {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  certificateId  String
  certificate    Certificate  @relation(fields: [certificateId], references: [certificateId])
  nfcUid         String?
  epc            String?
  assignedAt     DateTime     @default(now())
  lastSeenAt     DateTime?
  unassignedAt   DateTime?

  @@unique([organizationId, nfcUid])
  @@unique([organizationId, epc])
  @@index([certificateId])
}

// =====================================================================
// CmsDesign — TOP-LEVEL Landing Page Design BUNDLE.
// Each "landing page design" = ONE CmsDesign row = multiple inner CmsPage rows
// (sections/pages) linked via CmsPage.designId.
// This is what Product.cmsDesignId / Certificate.cmsDesignId point to.
// =====================================================================
model CmsDesign {
  id                  Int          @id @default(autoincrement())
  organizationId      Int
  organization        Organization @relation(fields: [organizationId], references: [id])

  // Identity
  name                String                            // Display name: "Sarang Madu Lama Landing"
  slug                String                            // URL slug: "sarang-madu-lama"
  kind                String       @default("landing")  // "landing" for public product page; "certificate" for verify/cert page
  description         String?                           // Optional admin memo

  // ===== INNER CHILDREN (1:many bundle → inner pages) =====
  pages               CmsPage[]

  // ===== NEW: Reverse relations for Product/Certificate FKs =====
  landingProducts     Product[]      @relation("LandingDesign")
  certificateProducts Product[]      @relation("CertificateDesign")
  certificates        Certificate[]  @relation("CertificateDesign2")

  // Publish state (copy pattern from CmsPage)
  draftVersionId      Int?
  publishedVersionId  Int?
  versionNo           Int          @default(1)

  // Audit
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  @@unique([organizationId, slug], map: "CmsDesign_organizationId_slug_key")
  @@index([organizationId, kind], map: "CmsDesign_organizationId_kind_idx")
}

model CmsPage {
  id                  Int          @id @default(autoincrement())
  organizationId      Int
  organization        Organization @relation(fields: [organizationId], references: [id])

  // ========== NEW: belongs to a CmsDesign (bundle/group) — NULL = legacy default group ==========
  designId            Int?

  name                String
  slug                String
  kind                String       @default("landing")   // "landing" default (use parent design.kind for top-level)
  sortOrder           Int          @default(0)
  layout              CmsLayout?

  // ===== DEPRECATED REVERSE RELATIONS (used to point at Product directly — now Product links to CmsDesign instead) =====
  landingProducts     Product[]    @relation("LandingPage")
  certificateProducts Product[]    @relation("CertificatePage")
  certificates        Certificate[] @relation("CertificateLandingPage")

  metaTitle           String?
  metaDescription     String?
  ogImage             String?

  draftVersionId      Int?
  draftVersion        CmsVersion?  @relation("DraftVersion", fields: [draftVersionId], references: [id])
  publishedVersionId  Int?
  publishedVersion    CmsVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  versions            CmsVersion[]
  translations        CmsTranslation[]

  versionNo           Int          @default(1)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  @@unique([organizationId, slug], map: "CmsPage_organizationId_slug_key")
  @@index([organizationId, kind], map: "CmsPage_organizationId_kind_idx")
  @@index([organizationId, designId], map: "CmsPage_organizationId_designId_idx")
}

model CmsVersion {
  id                Int          @id @default(autoincrement())
  organizationId    Int
  organization      Organization @relation(fields: [organizationId], references: [id])
  pageId            Int
  page              CmsPage      @relation(fields: [pageId], references: [id])
  draftForPages     CmsPage[]    @relation("DraftVersion")
  publishedForPages CmsPage[]    @relation("PublishedVersion")
  versionNo         Int
  status            String       @default("draft")
  layoutJson        Json
  createdAt         DateTime     @default(now())

  @@unique([pageId, versionNo], map: "CmsVersion_pageId_versionNo_key")
  @@index([organizationId, pageId], map: "CmsVersion_org_pageId_idx")
}

model CmsTranslation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  pageId         Int
  page           CmsPage      @relation(fields: [pageId], references: [id])
  language       String
  contentJson    Json
  updatedAt      DateTime     @updatedAt

  @@unique([pageId, language], map: "CmsTranslation_pageId_language_key")
  @@index([organizationId, pageId], map: "CmsTranslation_org_pageId_idx")
}

model CmsLayout {
  id             Int          @id @default(autoincrement())
  pageId         Int          @unique
  page           CmsPage      @relation(fields: [pageId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  layoutJson     Json // FULL drag-drop structure

  updatedAt DateTime @updatedAt
}

model CertificateTemplate {
  id              Int          @id @default(autoincrement())
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  certificateId   String
  templateType    String       @default("auth")
  name            String
  background      String // URL to background image
  backgroundColor String       @default("#ffffff")
  backgroundMode  String       @default("background")
  layoutJson      Json // Overlay field positions
  placeholders    Json?
  canvasWidth     Int          @default(390)
  canvasHeight    Int          @default(844)

  products   Product[]
  epcBatches EpcBatch[] @relation("EpcBatchTemplate")
  productSupportingCertificates ProductSupportingCertificate[]
  translations CertificateTemplateTranslation[]

  versionNo Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, certificateId])
}

model CertificateTemplateTranslation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  templateId     Int
  template       CertificateTemplate @relation(fields: [templateId], references: [id])
  language       String
  layoutJson     Json
  placeholders   Json?
  updatedAt      DateTime     @updatedAt

  @@unique([templateId, language])
  @@index([organizationId, templateId])
}

model MediaAsset {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  originalName String
  fileName     String
  mimeType     String
  sizeBytes    Int
  url          String
  processingStatus String   @default("ready")
  processingError  String?
  posterUrl        String?
  processedAt      DateTime?
  processingJobId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, fileName])
  @@index([organizationId])
  @@index([createdAt])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
}

model OrganizationNotificationConfig {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String       @db.VarChar(191)
  isEnabled      Boolean      @default(true)
  roleNamesJson  Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key], map: "OrganizationNotificationConfig_organizationId_key_key")
  @@index([organizationId], map: "OrganizationNotificationConfig_organizationId_idx")
}
