node_modules
.vercel
# Keep environment variables out of version control
.env
.env.*
!.env.example
!.env.sample

/src/generated/prisma
frontend/playwright-report/
frontend/pw-browsers/
frontend/test-results/
frontend/playwright-test-output.log
frontend/.env.development
frontend/*.log

# ===== USER-GENERATED DATA — NEVER COMMIT, NEVER CLEAN =====
# Uploaded media files (images/videos/documents from CMS, Products, EPC etc)
uploads/
!uploads/.gitkeep

# Application logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2-*.log

# PM2 / process manager files
ecosystem.local.json
.pm2/

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo

# Prisma temp / generated (additional safeguard)
prisma/*.db
prisma/*.db-journal
